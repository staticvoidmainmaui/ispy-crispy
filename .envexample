# .env example for ispy-crispy project

# ── CockroachDB (the port target) ──
# ccloud cluster sql <cluster> --connection-url -u <user>
# Percent-encode special characters in the password (@ becomes %40).
DATABASE_URL=postgresql://<user>:<password>@<cluster>.<region>.cockroachlabs.cloud:26257/defaultdb?application_name=ispy-specmem&sslmode=verify-full

# ── Supabase (the port SOURCE ) ──
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_API_KEY=your-supabase-api-key

# ── Anthropic ──
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── AWS DynamoDB──
AWS_REGION=us-east-1
EMBEDDING_PROVIDER=titan
EVENTS_TABLE_NAME=events

# LOCAL DEV ONLY. Set = DynamoDB Local. Unset = real AWS DynamoDB.
DYNAMODB_ENDPOINT=http://localhost:8000
